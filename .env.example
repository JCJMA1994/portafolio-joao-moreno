# ── Panel de estadísticas en /links/stats ──
# Si no las defines, la ruta queda cerrada (no abierta). Fallar cerrado.
STATS_USER=jose
STATS_PASSWORD=cambia-esto-por-algo-largo-y-aleatorio

# ── Analítica de clics (opcional) ──
# Crea una base gratis en https://turso.tech y ejecuta schema.sql.
# Si las dejas vacías, /links funciona igual: solo no se registran clics.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
