---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
---

<Base
  title="Página no encontrada"
  description="Esta ruta no existe. Vuelve al inicio o mira los artículos."
  path="/404"
  noindex
>
  <Nav />
  <main
    id="main"
    class="mx-auto flex min-h-[60vh] max-w-[80rem] flex-col justify-center px-[var(--pad)] py-20"
  >
    <p class="m-0 font-jp text-xl font-bold text-red">
      404
      <small class="mt-1 block font-mono text-[0.5rem] tracking-[0.16em] font-normal text-slate">
        Ruta inexistente
      </small>
    </p>
    <h1 class="mt-4 max-w-[24ch] text-[clamp(2rem,8vw,5rem)] leading-[0.9] font-black">
      Esta pantalla no existe
    </h1>
    <p class="mt-5 max-w-[44ch]">
      El enlace está roto o la página se movió. La diferencia con una app sin conexión es que aquí
      no hay cola de reintentos que salve la situación.
    </p>
    <div class="mt-8 flex flex-wrap gap-2.5">
      <a href="/" class="btn btn-solid">Volver al inicio</a>
      <a href="/blog" class="btn btn-ghost">Ver los artículos</a>
    </div>
  </main>
  <Footer />
</Base>
