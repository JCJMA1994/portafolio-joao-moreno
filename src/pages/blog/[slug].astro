---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { formatDate, isoDate, readingTime } from '@/lib/utils';
import { profile } from '@/data/profile';
import { getSeriesNav } from '@/lib/series';
import LevelBadge from '@/components/LevelBadge.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2);
const minutes = readingTime(post.body ?? '');
const origin = Astro.site?.origin ?? '';
const number = String(post.data.number).padStart(3, '0');

const all = await getCollection('blog', ({ data }) => !data.draft);
const seriesNav = getSeriesNav(all, post.id);
const related = seriesNav
  ? []
  : all
      .filter(
        (item) => item.id !== post.id && item.data.tags.some((tag) => post.data.tags.includes(tag)),
      )
      .slice(0, 2);
---

<Base
  title={`${post.data.title} · ${profile.name}`}
  description={post.data.description}
  path={`/blog/${post.id}`}
  ogImage={post.data.ogImage}
  schema={[
    {
      '@type': 'BlogPosting',
      '@id': `${origin}/blog/${post.id}#article`,
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
      keywords: post.data.tags.join(', '),
      inLanguage: 'es-PE',
      wordCount: (post.body ?? '').split(/\s+/).length,
      author: { '@id': `${origin}/#person` },
      publisher: { '@id': `${origin}/#person` },
      isPartOf: { '@id': `${origin}/blog#blog` },
      mainEntityOfPage: { '@type': 'WebPage', '@id': `${origin}/blog/${post.id}` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: origin },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${origin}/blog` },
        { '@type': 'ListItem', position: 3, name: post.data.title },
      ],
    },
  ]}
>
  <Nav />
  <main id="main" class="mx-auto max-w-[80rem] px-[var(--pad)]">
    <nav aria-label="Ruta del artículo" class="article-breadcrumb">
      <ol class="m-0 flex list-none flex-wrap gap-2 p-0">
        <li><a href="/blog">Blog</a></li><li aria-hidden="true">/</li>
        <li><a href={`/blog/tag/${post.data.tags[0]}`}>{post.data.tags[0]}</a></li>
        <li aria-hidden="true">/</li><li aria-current="page">Registro {number}</li>
      </ol>
    </nav>

    <article>
      <header class="article-hero">
        <div>
          <p class="article-label">Registro {number} · Arquitectura móvil</p>
          <h1 class="max-w-[17ch] text-[clamp(2.6rem,8vw,5.8rem)] leading-[0.92]">
            {post.data.title}
          </h1>
          <p class="mt-6 max-w-[58ch] text-sm text-slate">{post.data.description}</p>
          <div class="article-meta" aria-label="Datos del artículo">
            <LevelBadge level={post.data.level} />
            <span>{minutes} min de lectura</span>
            <time datetime={isoDate(post.data.pubDate)}
              >Publicado {formatDate(post.data.pubDate)}</time
            >
          </div>
        </div>
        <aside
          class="article-hero-note"
          aria-label={seriesNav ? 'Serie del artículo' : 'Nota editorial'}
        >
          <p class="article-label">{seriesNav ? `Serie · ${seriesNav.name}` : 'Nota de campo'}</p>
          <p>
            {
              seriesNav
                ? `Entrega ${seriesNav.index} de ${seriesNav.total}`
                : post.data.tags.join(' · ')
            }
          </p>
          <p class="m-0">Persistir → encolar → reconciliar.</p>
        </aside>
      </header>

      <div class="article-grid">
        {
          toc.length > 0 && (
            <aside class="article-index" aria-label="Índice del artículo">
              <span class="article-label">En este registro</span>
              <ol>
                {toc.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </aside>
          )
        }
        <div class="prose-manga article-body"><Content /></div>
      </div>
    </article>

    {
      seriesNav && (
        <nav class="series-footer" aria-label="Navegación de la serie">
          {seriesNav.prev ? (
            <a class="series-link" href={`/blog/${seriesNav.prev.id}`}>
              <span class="article-label">
                ← Anterior · {seriesNav.index - 1}/{seriesNav.total}
              </span>
              <span>{seriesNav.prev.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {seriesNav.next && (
            <a class="series-link text-right" href={`/blog/${seriesNav.next.id}`}>
              <span class="article-label">
                Siguiente · {seriesNav.index + 1}/{seriesNav.total} →
              </span>
              <span>{seriesNav.next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }

    {
      !seriesNav && related.length > 0 && (
        <aside class="series-footer" aria-label="Artículos relacionados">
          {related.map((item) => (
            <a class="series-link" href={`/blog/${item.id}`}>
              <span class="article-label">Sigue leyendo</span>
              <span>{item.data.title}</span>
            </a>
          ))}
        </aside>
      )
    }
  </main>
  <Footer />
</Base>

<style>
  .article-label {
    display: block;
    margin: 0 0 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-slate);
  }
  .article-breadcrumb {
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-ink);
    font: 0.625rem var(--font-mono);
    color: var(--color-slate);
  }
  .article-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(13rem, 0.42fr);
    gap: 2rem;
    padding-block: 3.5rem 2rem;
    border-bottom: 1px solid var(--color-ink);
  }
  .article-hero-note {
    align-self: end;
    border-left: 0.65rem solid var(--color-signal);
    padding-left: 1rem;
    font-size: 0.875rem;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    font: 0.625rem var(--font-mono);
    color: var(--color-slate);
  }
  .article-grid {
    display: grid;
    grid-template-columns: minmax(11rem, 0.32fr) minmax(0, 1fr);
    gap: 3rem;
    padding-block: 2.5rem;
  }
  .article-index {
    align-self: start;
    position: sticky;
    top: 8rem;
    border-top: 4px solid var(--color-ink);
    padding-top: 1rem;
    font-size: 0.75rem;
  }
  .article-index ol {
    margin: 1rem 0 0;
    padding-left: 1.4rem;
    color: var(--color-slate);
  }
  .article-index li {
    margin-bottom: 0.7rem;
  }
  .article-index a {
    text-underline-offset: 0.28rem;
  }
  .article-body {
    min-width: 0;
  }
  .article-body :global(h2),
  .article-body :global(h3) {
    scroll-margin-top: 9rem;
  }
  .series-footer {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--color-ink);
  }
  .series-link {
    display: grid;
    gap: 0.2rem;
    max-width: 28rem;
  }
  @media (max-width: 48rem) {
    .article-hero,
    .article-grid {
      grid-template-columns: 1fr;
    }
    .article-hero {
      padding-top: 2rem;
    }
    .article-grid {
      gap: 2rem;
    }
    .article-index {
      position: static;
      border-top-width: 1px;
      border-bottom: 1px solid var(--color-ink);
      padding-bottom: 1rem;
    }
    .article-index ol {
      columns: 2;
    }
  }
  @media (max-width: 28rem) {
    .article-index ol {
      columns: 1;
    }
    .series-footer {
      align-items: flex-start;
      flex-direction: column;
    }
    .series-link {
      text-align: left;
    }
  }
</style>
