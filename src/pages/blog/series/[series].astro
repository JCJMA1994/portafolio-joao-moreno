---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import TitleCard from '@/components/TitleCard.astro';
import PostCard from '@/components/PostCard.astro';
import { readingTime } from '@/lib/utils';
import { profile } from '@/data/profile';
import { getSeriesPosts, slugifySeries, uniqueSeriesNames } from '@/lib/series';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const names = uniqueSeriesNames(posts);
  return names.map((name) => ({
    params: { series: slugifySeries(name) },
    props: { name, posts: getSeriesPosts(posts, name) },
  }));
}

const { name, posts } = Astro.props;
---

<Base
  title={`${name} · Blog de ${profile.name}`}
  description={`Serie "${name}": ${posts.length} artículos escritos en orden por ${profile.name}, desarrollador Flutter especializado en apps offline-first.`}
  path={`/blog/series/${slugifySeries(name)}`}
>
  <Nav />
  <main id="main" class="mx-auto max-w-[80rem] px-[var(--pad)] py-16 sm:py-24">
    <TitleCard ep={1} title={name} meta={`${posts.length} artículos · serie`} />
    <a
      href="/blog"
      class="mb-8 inline-block font-mono text-[0.625rem] tracking-[0.1em] text-slate uppercase no-underline hover:text-ink"
    >
      ← Todos los artículos
    </a>
    <ul class="m-0 list-none p-0">
      {
        posts.map((post) => (
          <PostCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            minutes={readingTime(post.body ?? '')}
            tags={post.data.tags}
            level={post.data.level}
          />
        ))
      }
    </ul>
  </main>
  <Footer />
</Base>
