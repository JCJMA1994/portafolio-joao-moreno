---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import TitleCard from '@/components/TitleCard.astro';
import { formatDate, isoDate, deservesOwnPage, readingTime } from '@/lib/utils';
import { profile } from '@/data/profile';

const tips = (await getCollection('tips', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.number - a.data.number,
);

// Los apuntes cortos se leen completos aquí. Solo los que pasan el
// umbral de 300 palabras reciben URL propia: una página con 80
// palabras es contenido pobre y arrastra al resto del dominio.
const rendered = await Promise.all(
  tips.map(async (tip) => ({
    tip,
    Content: (await render(tip)).Content,
    ownPage: deservesOwnPage(tip.body ?? ''),
  })),
);
---

<Base
  title={`Apuntes · ${profile.name}`}
  description="Apuntes cortos sobre Flutter, Dart, SQLite y Firebase. Cosas que me habría gustado saber antes, numeradas por si las quieres citar."
  path="/tips"
  schema={[
    {
      '@type': 'ItemList',
      name: 'Apuntes',
      numberOfItems: tips.length,
      itemListOrder: 'https://schema.org/ItemListOrderDescending',
      itemListElement: tips.map((tip, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `#${String(tip.data.number).padStart(3, '0')} ${tip.data.title}`,
      })),
    },
  ]}
>
  <Nav />
  <main id="main" class="mx-auto max-w-[80rem] px-[var(--pad)] py-16 sm:py-24">
    <TitleCard ep={2} title="Apuntes" meta={`${tips.length} en total`} />

    <p class="mb-12 max-w-[44ch] font-read text-lg italic">
      Cosas cortas que me habría gustado saber antes. Numeradas por si las quieres citar.
    </p>

    <div class="grid gap-6">
      {
        rendered.map(({ tip, Content, ownPage }) => (
          <article class="panel p-6" id={`apunte-${tip.data.number}`}>
            <header class="mb-4 flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-tone pb-3">
              <span class="font-impact text-3xl leading-none font-black text-red">
                {String(tip.data.number).padStart(3, '0')}
              </span>
              <h2 class="text-xl">
                {ownPage ? (
                  <a href={`/tips/${tip.id}`} class="no-underline hover:text-red">
                    {tip.data.title}
                  </a>
                ) : (
                  tip.data.title
                )}
              </h2>
              <p class="ml-auto m-0 font-mono text-[0.5625rem] tracking-[0.12em] text-slate uppercase">
                <time datetime={isoDate(tip.data.pubDate)}>{formatDate(tip.data.pubDate)}</time>·{' '}
                {tip.data.tag} · {readingTime(tip.body ?? '')} min
              </p>
            </header>
            <div class="prose-manga text-base">
              <Content />
            </div>
          </article>
        ))
      }
    </div>
  </main>
  <Footer />
</Base>
