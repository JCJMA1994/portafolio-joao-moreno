---
import { stack, alsoKnows } from '@/data/profile';

/** Dibuja el prefijo de rama del árbol según profundidad y posición. */
function prefix(indent: number, last?: boolean): string {
  if (indent === 0) return '';
  return '\u00A0'.repeat((indent - 1) * 3) + (last ? '└─' : '├─');
}
---

<div class="panel">
  <div class="overflow-x-auto p-5 font-mono text-[0.6875rem] leading-[2.4]">
    {
      stack.map((node) => (
        <div class="flex items-baseline gap-2 whitespace-nowrap">
          <span class="text-tone">{prefix(node.indent, node.last)}</span>
          <span class:list={['font-semibold', node.root && 'text-red']}>{node.widget}</span>
          <span class="ml-auto hidden pl-6 font-read text-[0.8125rem] italic text-slate md:block">
            {node.why}
          </span>
        </div>
      ))
    }
  </div>
</div>

<p class="mt-3.5 font-mono text-xs tracking-[0.02em] text-slate">También: {alsoKnows}</p>
