---
import { stackLayers, alsoKnows } from '@/data/profile';
---

<div class="space-y-4">
  <div tabindex="0" role="region" aria-label="Arquitectura y stack por capas" class="grid gap-3">
    {
      stackLayers.map((layer, index) => (
        <div class="group border-2 border-ink p-5 transition-all hover:screentone">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-tone pb-3">
            <div class="flex items-center gap-2.5">
              <span class="inline-flex size-6 items-center justify-center rounded-sm bg-ink font-mono text-[0.625rem] font-bold text-paper">
                0{index + 1}
              </span>
              <h3 class="m-0 text-base font-bold tracking-[0.04em]">{layer.layer}</h3>
            </div>
            <span class="border border-red bg-red/10 px-2 py-0.5 font-mono text-[0.5625rem] font-semibold tracking-[0.12em] text-red uppercase">
              {layer.badge}
            </span>
          </div>

          <p class="mt-3 mb-4 text-[0.875rem] leading-[1.5] text-slate">{layer.description}</p>

          <div class="flex flex-wrap gap-2">
            {layer.skills.map((skill) => (
              <span
                class:list={[
                  'inline-flex items-center gap-1.5 border px-2.5 py-1 font-mono text-[0.6875rem] transition-colors',
                  skill.highlight
                    ? 'border-ink bg-ink font-semibold text-paper'
                    : 'border-tone bg-transparent text-slate hover:border-ink hover:text-ink',
                ]}
              >
                <svg
                  class:list={['size-3.5 shrink-0', skill.highlight ? 'text-red' : 'text-slate']}
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {skill.icon === 'flutter' && (
                    <>
                      <path d="M14 2L3 13l3.5 3.5L20 3.5 14 2z" />
                      <path d="M14 15l-5 5 3.5 3.5L21 15h-7z" />
                    </>
                  )}
                  {skill.icon === 'dart' && (
                    <>
                      <path d="M4 4l8 8-8 8V4z" />
                      <path d="M12 12l8 8H12v-8z" />
                    </>
                  )}
                  {skill.icon === 'bloc' && (
                    <>
                      <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
                      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                    </>
                  )}
                  {skill.icon === 'architecture' && (
                    <>
                      <polygon points="12 2 2 7 12 12 22 7 12 2" />
                      <polyline points="2 17 12 22 22 17" />
                      <polyline points="2 12 12 17 22 12" />
                    </>
                  )}
                  {skill.icon === 'sqlite' && (
                    <>
                      <ellipse cx="12" cy="5" rx="9" ry="3" />
                      <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                      <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                    </>
                  )}
                  {skill.icon === 'ocr' && (
                    <>
                      <rect x="3" y="4" width="18" height="16" rx="2" />
                      <circle cx="9" cy="10" r="2" />
                      <path d="M15 8h2" />
                      <path d="M15 12h2" />
                      <path d="M7 16h10" />
                    </>
                  )}
                  {skill.icon === 'spring' && (
                    <>
                      <path d="M12 2a10 10 0 0 1 10 10c0 5.5-4.5 10-10 10S2 17.5 2 12 6.5 2 12 2" />
                      <path d="M12 6c3 0 5 2 5 5 0 4-5 7-5 7s-5-3-5-7c0-3 2-5 5-5z" />
                    </>
                  )}
                  {skill.icon === 'java' && (
                    <>
                      <path d="M18 8h1a4 4 0 0 1 0 8h-1" />
                      <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" />
                      <line x1="6" y1="1" x2="6" y2="4" />
                      <line x1="10" y1="1" x2="10" y2="4" />
                      <line x1="14" y1="1" x2="14" y2="4" />
                    </>
                  )}
                  {skill.icon === 'firebase' && (
                    <>
                      <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07 1.29-2 2.76-2 4 0 .54.18 1.04.5 1.5z" />
                      <path d="M14.5 17.5c-.78.32-1.63.5-2.5.5-3.31 0-6-2.69-6-6 0-1.66.67-3.16 1.76-4.24L12 2l4.24 5.76C17.33 8.84 18 10.34 18 12c0 1.66-.67 3.16-1.76 4.24l-1.74 1.26z" />
                    </>
                  )}
                  {skill.icon === 'shorebird' && (
                    <>
                      <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                    </>
                  )}
                  {skill.icon === 'sentry' && (
                    <>
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                      <line x1="12" y1="8" x2="12" y2="12" />
                      <line x1="12" y1="16" x2="12.01" y2="16" />
                    </>
                  )}
                  {skill.icon !== 'flutter' &&
                    skill.icon !== 'dart' &&
                    skill.icon !== 'bloc' &&
                    skill.icon !== 'architecture' &&
                    skill.icon !== 'sqlite' &&
                    skill.icon !== 'ocr' &&
                    skill.icon !== 'spring' &&
                    skill.icon !== 'java' &&
                    skill.icon !== 'firebase' &&
                    skill.icon !== 'shorebird' &&
                    skill.icon !== 'sentry' && (
                      <>
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                      </>
                    )}
                </svg>
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <p class="mt-4 font-mono text-xs tracking-[0.02em] text-slate">
    Complementos y herramientas secundarias: {alsoKnows}
  </p>
</div>
