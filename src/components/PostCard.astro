---
import LevelBadge from '@/components/LevelBadge.astro';

interface Props {
  number: number;
  slug: string;
  title: string;
  description: string;
  minutes: number;
  tags: string[];
  level: 'principiante' | 'intermedio' | 'avanzado';
}

const { number, slug, title, description, minutes, tags, level } = Astro.props;
const displayNumber = String(number).padStart(3, '0');
---

<li class="field-entry">
  <span class="field-entry-number font-mono text-sm text-slate" data-post-number>
    {displayNumber}
  </span>
  <div>
    <h3 class="text-[clamp(1.35rem,3vw,2rem)] leading-none">
      <a href={`/blog/${slug}`} class="underline decoration-1 underline-offset-6 hover:text-red">
        {title}
      </a>
    </h3>
    <p class="mt-2 mb-0 max-w-[58ch] text-sm text-slate">{description}</p>
  </div>
  <div class="flex flex-wrap content-start items-center gap-2 font-mono text-[0.625rem] text-slate">
    <LevelBadge level={level} />
    <span>{String(minutes).padStart(2, '0')} min</span>
    <span>{tags[0]}</span>
  </div>
</li>

<style>
  .field-entry {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) minmax(12rem, 0.45fr);
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-ink);
  }
  @media (max-width: 44rem) {
    .field-entry {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
    .field-entry-number {
      border-bottom: 1px solid var(--color-tone);
      padding-bottom: 0.35rem;
    }
  }
</style>
