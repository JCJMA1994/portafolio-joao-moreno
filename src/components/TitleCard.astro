---
/**
 * Title card de episodio. Cada sección abre como un capítulo de anime.
 * `ep` acepta número o 'final' para 最終話.
 */
interface Props {
  ep: number | 'final';
  title: string;
  meta?: string;
}
const { ep, title, meta } = Astro.props;
const jp = ep === 'final' ? '最終話' : `第${String(ep).padStart(2, '0')}話`;
const label = ep === 'final' ? 'Episodio final' : `Episodio ${String(ep).padStart(2, '0')}`;
---

<div class="mb-10 flex items-end gap-4 border-b-2 border-ink pb-2.5">
  <span class="font-jp text-[1.375rem] leading-none font-bold whitespace-nowrap text-red">
    {jp}
    <small class="mt-1.5 block font-mono text-[0.5rem] font-normal tracking-[0.16em] text-slate">
      {label}
    </small>
  </span>
  <h2 class="text-[clamp(1.75rem,5.5vw,3rem)] font-black tracking-[0.005em]">{title}</h2>
  {
    meta && (
      <span class="ml-auto hidden pb-1 font-mono text-[0.625rem] tracking-[0.14em] whitespace-nowrap text-slate sm:block">
        {meta}
      </span>
    )
  }
</div>
